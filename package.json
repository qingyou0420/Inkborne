{
  "name": "fantawriter",
  "version": "2.1.9",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Inkborne / 墨生万象（原名幻想作家）— InkOS-kernel Windows desktop writing studio",
  "author": "Inkborne",
  "main": "packages/desktop/main.cjs",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @fantawriter/desktop dev",
    "start": "pnpm --filter @fantawriter/desktop start",
    "build": "pnpm --filter @actalk/inkos-core build && pnpm --filter @actalk/inkos-studio build",
    "test": "pnpm --filter @actalk/inkos-core test && pnpm --filter @actalk/inkos-studio test && pnpm --filter @actalk/inkos test && pnpm --filter @fantawriter/desktop test",
    "test:core:full": "pnpm --filter @actalk/inkos-core test:full",
    "test:core": "pnpm --filter @actalk/inkos-core test",
    "test:desktop": "pnpm --filter @fantawriter/desktop test",
    "typecheck": "pnpm --filter @actalk/inkos-core build && pnpm --filter @actalk/inkos-studio exec tsc --noEmit && pnpm --filter @actalk/inkos-studio exec tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "engine:smoke": "node scripts/engine-smoke.mjs",
    "engine:pack-smoke": "node scripts/engine-pack-smoke.mjs",
    "assemble:engine": "node scripts/assemble-engine.mjs",
    "dist:win": "node scripts/dist-win.mjs",
    "dist:win:ci": "node scripts/dist-win.mjs --publish-never",
    "dist:dir": "node scripts/dist-win.mjs --dir --publish-never",
    "publish:update": "node scripts/publish-update.mjs"
  },
  "pnpm": {
    "overrides": {
      "@mariozechner/pi-ai": "0.67.1",
      "@mariozechner/pi-agent-core": "0.67.1"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "typescript-eslint": "^8.70.1"
  }
}
